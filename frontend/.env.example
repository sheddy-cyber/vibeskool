# VibeSkool frontend environment variables. Copy to .env and fill in.

# Leave empty in development: the dev server proxies /api to Django (localhost:8000).
# In production, set it to the API's address, e.g. https://api.example.com
VITE_API_URL=

# Google OAuth client ID (Google Cloud Console -> Credentials)
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
