# Copy to .env for local development. On Render these are set in the
# dashboard (see render.yaml at the repo root and DEPLOYING.md).
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=change-me
# Signs sign-in tokens. Keep it secret and stable: changing it signs everyone out.
# With DEBUG off, both secrets must be 32+ random characters or the server won't start:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-at-least-32-random-characters
GOOGLE_CLIENT_ID=
FRONTEND_URL=http://localhost:5173

# Database. Leave unset locally to use SQLite. Supabase: the session pooler
# address (port 5432) from Connect -> Session pooler.
# DATABASE_URL=postgres://user:password@host:5432/dbname
# DB_POOL_SIZE=5

# Hosts and origins (production)
# DJANGO_ALLOWED_HOSTS=api.example.com          # Render's own address is added automatically
# CORS_ALLOWED_ORIGINS=https://vibeskool.example.com   # defaults to FRONTEND_URL
# REDIS_URL=redis://localhost:6379/0            # live updates and rate limits across processes
# ADMIN_PATH=admin                              # move the admin somewhere less obvious

# Uploads in Supabase Storage (public bucket). Project settings -> Storage -> S3 connection.
# STORAGE_BUCKET=media
# STORAGE_ENDPOINT=https://<project>.storage.supabase.co/storage/v1/s3
# STORAGE_REGION=eu-west-2
# STORAGE_ACCESS_KEY=
# STORAGE_SECRET_KEY=
# STORAGE_PUBLIC_URL=https://<project>.supabase.co/storage/v1/object/public/media

# Email (password resets, tutor requests). Unset = printed to the console.
# Brevo's web API (works on Render's free plan, which blocks SMTP ports):
# BREVO_API_KEY=
# DEFAULT_FROM_EMAIL=VibeSkool <vibeskool.app@gmail.com>   # a sender verified in Brevo
# ...or any SMTP server (paid hosting only on Render):
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# TUTOR_REQUEST_EMAILS=you@example.com          # defaults to every staff account

# AI tutor (free key from aistudio.google.com/apikey)
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-lite-latest          # the default; only set it to use another model

# Running exercise code: Judge0 on RapidAPI (rapidapi.com/judge0-official/api/judge0-ce)
# JUDGE0_KEY=
# JUDGE0_URL=https://judge0-ce.p.rapidapi.com
# JUDGE0_JS_ID=93        # Node.js 18; check /languages on your Judge0 if runs fail
# JUDGE0_PYTHON_ID=92    # Python 3.11
# ...or a self-hosted Piston instead:
# PISTON_URL=http://your-piston-host:2000/api/v2

# Error reports (sentry.io)
# SENTRY_DSN=
