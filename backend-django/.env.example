# Copy to .env for local development.
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=change-me
# Signs sign-in tokens. Keep it secret and stable: changing it signs everyone out
JWT_SECRET=change-me-to-at-least-32-random-characters
GOOGLE_CLIENT_ID=
FRONTEND_URL=http://localhost:5173

# Production only. Leave unset locally to use SQLite.
# DATABASE_URL=postgres://user:password@host:5432/dbname
# DJANGO_ALLOWED_HOSTS=api.example.com
# CORS_ALLOWED_ORIGINS=https://vibeskool.example.com
# REDIS_URL=redis://localhost:6379/0   # live updates across several processes
# MEDIA_ORIGIN=https://api.example.com   # where /media uploads are served from
# GEMINI_API_KEY=          # turns on the AI tutor and exercise hints
# PISTON_URL=https://emkc.org/api/v2/piston   # sandbox that runs exercise code
