# VibeSkool Backend — Environment Variables
# Copy this file to .env and fill in your values

NODE_ENV=development
PORT=4000

# Frontend URL (for CORS)
CLIENT_URL=http://localhost:5173

# PostgreSQL connection string (Supabase, Neon, or local)
DATABASE_URL=postgresql://user:password@localhost:5432/vibeskool

# JWT Secret — generate a random string for production
# e.g.: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-jwt-secret-here

# AI Provider (Phase 3) — Gemini API key
# GEMINI_API_KEY=your-gemini-api-key
